.Rproj.user
.Rhistory
.RData
.Ruserdata

# Machine-specific paths and credentials (copy .Renviron.example to .Renviron)
.Renviron

# ---------------------------------------------------------------------------
# Data: ALLOW-LIST. Incident-level data (incident numbers, locations, alarm
# times) and travel matrices must never be tracked. Everything under datasets/
# is ignored unless it is listed below as a non-incident reference file.
# Adding a new tracked data file means adding an explicit "!" line here.
# ---------------------------------------------------------------------------
datasets/*
!datasets/inputs/
datasets/inputs/*
!datasets/inputs/*_cad_run_card.csv
!datasets/inputs/*_station_addresses.csv
!datasets/inputs/*_ems_unit_capabilities.csv
!datasets/inputs/*_fdzs.csv

# Legacy app data: only the lookup files are tracked. The app travel matrix and
# the per-incident categories are incident-level and stay local (they are still
# in history from before the refactor; history is not rewritten).
legacy/app/data/*
!legacy/app/data/code_lookup.parquet
!legacy/app/data/ems_capabilities.parquet
!legacy/app/data/fdz_polygons.rds
!legacy/app/data/filter_values.rds
!legacy/app/data/runcard_beats.parquet
!legacy/app/data/stations.parquet

# Belt and braces, anywhere in the repo
*travel_matrix*.csv
*travel_matrix*.parquet
*travel_matrix*.rds
*_cad_incident_locations.csv
*incident_address_data*.csv
*.xlsx

# Phase 0 baseline outputs (incident-level, local only)
_baseline/
# Rendered tutorial output (built from incident-level data) and Quarto cache
legacy/tutorials/deployment_analysis_phase_1.html
.quarto/

# Street-map tiles cached by the static maps (rosm / ggspatial)
rosm.cache/
